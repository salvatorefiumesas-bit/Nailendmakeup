{
  "appId": "it.nailsandmakeup.prenota",
  "appName": "Nails & Makeup",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#3E1A3C"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_nm",
      "iconColor": "#B5386B"
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  }
}
