rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function ymd(t) { return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day()); }

    // Chi può entrare nell'area riservata: un documento admins/<UID>
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Orari occupati: pubblici, senza dati personali
    match /busy/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['data','ora','dur'])
        && request.resource.data.data is string
        && request.resource.data.ora is int
        && request.resource.data.dur is int;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null
        && get(/databases/$(database)/documents/bookings/$(id)).data.uid == request.auth.uid);
    }

    // Dati della cliente (nome, cognome, telefono, email): salvati al primo appuntamento, solo lei li legge e li modifica
    match /clienti/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','cogn','tel','mail'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.cogn is string && request.resource.data.cogn.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 30
        && request.resource.data.mail is string && request.resource.data.mail.size() <= 120;
      allow delete: if false;
    }

    // Prenotazioni complete: la cliente (con accesso Google) crea le proprie e legge solo quelle sue; l'admin le gestisce tutte
    match /bookings/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['annullato','annullatoIl','annullatoDa'])
        && request.resource.data.annullato == true
        && (!('data' in resource.data)
          || resource.data.data >= ymd(request.time + duration.value(2, 'd'))));
      allow delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','uid','tipo','data','ora','dur','sv','nome','cogn','tel','mail','note'])
        && request.resource.data.keys().hasAll(['id','uid','tipo','dur','sv','nome','cogn','tel','mail'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.cogn is string && request.resource.data.cogn.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 30
        && request.resource.data.mail is string && request.resource.data.mail.size() <= 120;
    }
  }
}
